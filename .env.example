PORT=8080
ENV=development
DATABASE_URL=postgres://lullify:lullify_dev@postgres:5432/lullify?sslmode=disable
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=changeme-access
JWT_REFRESH_SECRET=changeme-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=lullify-backend
STORAGE_PATH=/data/audio
STORAGE_PROVIDER=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=lullify_admin
MINIO_SECRET_KEY=lullify_dev_secret_change_me
MINIO_BUCKET=lullify-audio
MINIO_USE_SSL=false
MAX_UPLOAD_SIZE_BYTES=52428800